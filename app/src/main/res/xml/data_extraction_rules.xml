<?xml version="1.0" encoding="utf-8"?><!--
   Backup and transfer rules for Android 12+ (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Financial data stays on the device by default (CLAUDE.md, docs/DECISIONS.md D-005 and D-007):
   the Room database is excluded from cloud backup. Direct device-to-device transfer
   (user-initiated when moving to a new phone) is left at the platform default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="money_tracker.db" />
        <exclude domain="database" path="money_tracker.db-shm" />
        <exclude domain="database" path="money_tracker.db-wal" />
        <exclude domain="database" path="money_tracker.db-journal" />
    </cloud-backup>
</data-extraction-rules>
