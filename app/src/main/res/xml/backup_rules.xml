<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 6 to 11 (API 23-30).
   Android 12+ (API 31+) uses data_extraction_rules.xml instead.
   See https://developer.android.com/identity/data/autobackup

   Financial data stays on the device by default (CLAUDE.md, docs/DECISIONS.md D-005 and D-007):
   the Room database is never uploaded to cloud backup. On these Android versions the
   same rules also apply to device-to-device transfer.
-->
<full-backup-content>
    <exclude domain="database" path="money_tracker.db" />
    <exclude domain="database" path="money_tracker.db-shm" />
    <exclude domain="database" path="money_tracker.db-wal" />
    <exclude domain="database" path="money_tracker.db-journal" />
</full-backup-content>
